# Lukearch x86_64 mirrorlist. mkarchiso does not copy the build host's
# mirrorlist, and the one from pacman-mirrorlist has every server commented out,
# so the live image ships these. The installer copies this file to the installed
# system. Both are run by Arch Linux and serve from a nearby location; for a
# ranked list of other mirrors, see https://archlinux.org/mirrorlist/.
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://fastly.mirror.pkgbuild.com/$repo/os/$arch
