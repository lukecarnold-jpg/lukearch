#!/bin/sh
# Sets the administrator password that sudo asks for on this live image.
# One-time: refuses to run once root already has a password, so the login
# password cannot be used to replace the administrator password later.
#
#   lukearch-set-admin-password --status   prints root=<state> lukearch=<state>
#
# The state is P (set), L (locked), or NP (no password). --status only reads
# the states; the desktop installer launcher uses it to know which to set.
set -eu

if [ "${1:-}" = "--status" ]; then
  printf 'root=%s\n' "$(passwd -S root | awk '{print $2}')"
  printf 'lukearch=%s\n' "$(passwd -S lukearch | awk '{print $2}')"
  exit 0
fi

status="$(passwd -S root | awk '{print $2}')"
if [ "$status" = "P" ]; then
  echo "The administrator password is already set." >&2
  exit 1
fi

exec passwd root
